root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sv,svh,v,vh}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 4

[*.{tcl,xdc,sh}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 4
